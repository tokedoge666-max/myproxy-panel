MYPROXY_ENV=production
MYPROXY_HOME=/opt/myproxy
MYPROXY_DB=/opt/myproxy/data/myproxy.db
MYPROXY_SINGBOX=/opt/myproxy/.runtime/sing-box/sing-box
MYPROXY_SINGBOX_CONFIG=/opt/myproxy/config/sing-box.json
MYPROXY_LOG_DIR=/opt/myproxy/logs
MYPROXY_BACKUP_DIR=/opt/myproxy/backups
MYPROXY_RUN_DIR=/opt/myproxy/run

MYPROXY_SESSION_TTL=43200
MYPROXY_COOKIE_SECURE=true
MYPROXY_ALLOWED_HOSTS=panel.example.com,localhost,127.0.0.1
MYPROXY_CORS_ORIGINS=
MYPROXY_USE_SUDO=true
MYPROXY_SINGBOX_SERVICE=myproxy-singbox.service
MYPROXY_SYSTEMCTL=/bin/systemctl
MYPROXY_SUDO=/usr/bin/sudo
MYPROXY_SINGBOX_VERSION=1.13.16
MYPROXY_BACKUP_LIMIT=20
MYPROXY_CERTIFICATE_PATH=/opt/myproxy/config/tls/fullchain.pem
MYPROXY_PRIVATE_KEY_PATH=/opt/myproxy/config/tls/privkey.pem

SERVER_IP=203.0.113.10
DOMAIN=panel.example.com
ACME_EMAIL=admin@example.com
SELF_SIGNED_MODE=false
